<Project Sdk="Microsoft.NET.Sdk">

	<!-- shared settings (target framework, package metadata, symbols, docs) live in
	     ../Directory.Build.props - only what is specific to this package is here.
	     Package versions are in ../Directory.Packages.props. -->

	<PropertyGroup>
		<PackageId>Jumoo.Json</PackageId>
		<Description>JSON Helper libraries for Jumoo Umbraco packages</Description>

		<PackageIcon>icon.png</PackageIcon>
		<PackageReadmeFile>readme.md</PackageReadmeFile>
	</PropertyGroup>

	<ItemGroup>
		<None Include="icon.png" Pack="true" PackagePath="\" />
		<None Include="readme.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Umbraco.Cms.Web.Common" />
	</ItemGroup>

</Project>
